{
  "name": "slack-agent-connector",
  "version": "1.0.0",
  "description": "Connect any DevRev AI agent to a Slack app; one install per connection.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "package": "tar -czf build.tar.gz dist package.json package-lock.json",
    "prepackage": "npm run build",
    "start": "ts-node src/main.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "license": "ISC",
  "dependencies": {
    "@devrev/typescript-sdk": "1.1.74",
    "@slack/web-api": "7.17.0",
    "axios": "1.20.0",
    "form-data": "4.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.3",
    "@types/yargs": "17.0.35",
    "jest": "30.4.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "yargs": "18.0.0"
  }
}
